NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_codes
WHATSAPP_CLIENT_ID=code-distribution-bot
# WhatsApp group ID (…@g.us) allowed to run the /calculate groups-status command. Leave empty to disable.
CALCULATE_ADMIN_GROUP_ID=
ADMIN_NUMBERS=923001234567,923009876543
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-secret
GROUP_RATE_LIMIT=5
GROUP_RATE_WINDOW_MINUTES=10
MAX_CSV_SIZE_MB=5
MAX_CODES_PER_REQUEST=50
TAG_RESPONSE_DELAY_MIN_SECONDS=5
TAG_RESPONSE_DELAY_MAX_SECONDS=10
WHATSAPP_RECONNECT_DELAY_MS=10000
# Optional when using an existing local Chrome/Edge installation:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
LOG_LEVEL=info
