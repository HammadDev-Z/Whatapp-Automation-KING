NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_codes
# Required by docker-compose.yml for BOTH the postgres container's own password and the
# app's DATABASE_URL (interpolated into both). Must be a strong, unique value in any
# environment reachable from outside localhost — never "postgres" or another default.
POSTGRES_PASSWORD=replace-with-a-strong-unique-password
WHATSAPP_CLIENT_ID=code-distribution-bot
# WhatsApp group ID (…@g.us) allowed to run the /calculate groups-status command. Leave empty to disable.
CALCULATE_ADMIN_GROUP_ID=
# WhatsApp group ID (…@g.us) that receives low-stock alerts after deliveries. Leave empty to disable.
LOW_STOCK_ALERT_GROUP_ID=
# WhatsApp group ID (…@g.us) that /pkr <message>, /usdt <message>, and /account broadcasts
# must be sent from. Leave empty to disable broadcasting entirely (bare /pkr and /usdt still work).
CURRENCY_BROADCAST_GROUP_ID=
# Random delay (seconds) between each group a broadcast sends to. Never applied before the first send.
BROADCAST_DELAY_MIN_SECONDS=10
BROADCAST_DELAY_MAX_SECONDS=15
ADMIN_NUMBERS=923001234567,923009876543
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-secret
GROUP_RATE_LIMIT=5
GROUP_RATE_WINDOW_MINUTES=10
MAX_CODES_PER_REQUEST=50
TAG_RESPONSE_DELAY_MIN_SECONDS=5
TAG_RESPONSE_DELAY_MAX_SECONDS=10
WHATSAPP_RECONNECT_DELAY_MS=10000
# Optional when using an existing local Chrome/Edge installation:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
LOG_LEVEL=info
